# KisanSlot Environment Configuration
# Copy this file to .env and adjust variables as needed

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://kisanslot:kisanslot_secret@localhost:5432/kisanslot_db
POSTGRES_USER=kisanslot
POSTGRES_PASSWORD=kisanslot_secret
POSTGRES_DB=kisanslot_db
POSTGRES_PORT=5432

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Configuration
APP_NAME=KisanSlot
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

